# ==============================================================================
# SENTINEL AI – Backend Environment Configuration Example
# Academic Project: CSE276 – Artificial Intelligence Foundations
# ==============================================================================

# Server Environment Mode: development | production | test
ENVIRONMENT=development

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# API Versioning Prefix
API_V1_STR=/api/v1

# Relational Database Connection (Default: embedded SQLite)
# For production PostgreSQL: postgresql://user:password@localhost:5432/sentinel_db
DATABASE_URL=sqlite:///sentinel.db

# Cross-Origin Resource Sharing (CORS) Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000

# File Upload Security Limits
MAX_UPLOAD_SIZE_MB=10

# Single Text Input Validation Limits (Characters)
MAX_TEXT_LENGTH=5000
